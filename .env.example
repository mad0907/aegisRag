# Ollama (native on host, not containerized)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_PRIMARY_MODEL=qwen2.5:7b-instruct
OLLAMA_EMBED_MODEL=nomic-embed-text

# Postgres + PGVector (docker-compose)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=aegisrag
POSTGRES_USER=aegisrag
POSTGRES_PASSWORD=aegisrag

# Arize Phoenix (docker-compose)
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:4317
PHOENIX_UI_URL=http://localhost:6006

# FastAPI backend (runs natively in the venv, not containerized)
API_HOST=0.0.0.0
API_PORT=8080

# Agent policy defaults — see doc/architecture and the design doc §4/§21
AGENT_MAX_ITERATIONS=3
RETRIEVAL_MIN_SCORE=0.70
ANSWER_AUTO_THRESHOLD=0.85
ANSWER_QUALIFY_THRESHOLD=0.60
