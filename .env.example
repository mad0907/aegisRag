# Ollama (native on host, not containerized)
# llama3.2:3b is primary for latency (~2x faster generation than qwen2.5:7b-instruct on
# CPU-only hardware); qwen2.5:7b-instruct is the fallback -- larger and slower, escalated to
# only on a primary-model failure (ADR-004).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_PRIMARY_MODEL=llama3.2:3b
OLLAMA_FALLBACK_MODEL=qwen2.5:7b-instruct
# "Light" tier (model_tiering.enabled in agent_policy.yaml) -- used only for the Planner's
# step. Not a fallback; a third, independent tier. See doc/13-latency-optimization.md for why
# only the Planner is tiered and not Evidence Validator / Citation & Quality.
OLLAMA_LIGHT_MODEL=llama3.2:1b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Postgres + PGVector (docker-compose)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=aegisrag
POSTGRES_USER=aegisrag
POSTGRES_PASSWORD=aegisrag

# Arize Phoenix (docker-compose)
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:4317
PHOENIX_UI_URL=http://localhost:6006

# FastAPI backend (runs natively in the venv, not containerized)
API_HOST=0.0.0.0
API_PORT=8080

# NOTE: agent behavior (max_iterations, retrieval/answer thresholds, smart_bypass, the
# semantic cache, human-review, fallback policy) is NOT configured here -- it all lives in
# src/aegisrag/config/agent_policy.yaml, the single AI control plane (ADR-008). This file is
# infrastructure config only (where things are), not behavior config (how the agents act).
